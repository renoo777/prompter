{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompter",
  "version": "0.1.1",
  "identifier": "cn.bobby.prompter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Prompter",
        "width": 560,
        "height": 360,
        "minWidth": 540,
        "minHeight": 160,
        "x": 48,
        "y": 48,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "visible": true,
        "focus": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0M0UwRjhFOUUxQTBFMkIKUldRckRocWVqZzgrRlBORUl1T2g2bTcyTDhvQnJqNHA3VkVPL0o2a0FGNFY3ditjcTZDMDdzVUMK",
      "endpoints": [
        "https://github.com/renoo777/prompter/releases/latest/download/latest.json"
      ]
    }
  }
}
